# ──────────────────────────────────────────────────────────────────────────────
# Kindred environment. Copy to .env.local. NEVER commit real keys.
# Server-side keys are read by Next.js route handlers (Moss, Cartesia TTS/STT for
# the Practice Studio) AND must also be pushed to the Convex deployment
# (post-call pipeline + LLM) with:  node scripts/setup-convex-env.mjs
# ──────────────────────────────────────────────────────────────────────────────

# --- Convex (written automatically by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Shared secret for Next.js → Convex server calls (generated by setup script)
KINDRED_SERVER_SECRET=
# Used by Convex Auth for redirects
SITE_URL=http://localhost:3000

# --- Cartesia (https://play.cartesia.ai → API keys) ---
# Ink (ink-whisper) speech-to-text + Sonic (sonic-3.6) text-to-speech
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-whisper
# Optional: any voice id from the Cartesia voice library
CARTESIA_VOICE_ID=

# --- Moss (https://usemoss.dev → project credentials) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_MODEL_ID=moss-minilm
# Kindred keeps everything in ONE index (fits Moss plans with a small per-project index quota)
MOSS_INDEX_NAME=kindred

# --- LLM: Claude via the Anthropic API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional TURN server for calls across strict NATs (public, used in the browser) ---
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
